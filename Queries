db.students.find()

// ---------- Comparison Operators ----------

// 5. Equal To ($eq)
db.students.find({marks: {$eq: 88}})

// 6. Greater Than ($gt)
db.students.find({marks: {$gt: 85}})

// 7. Less Than ($lt)
db.students.find({marks: {$lt: 60}})

// 8. Greater Than or Equal To ($gte)
db.students.find({marks: {$gte: 90}})

// 9. Less Than or Equal To ($lte)
db.students.find({marks: {$lte: 70}})

// ---------- Update & Delete ----------

// 10. Update Operation
db.students.updateOne(
  {roll: 105},
  {$set: {marks: 95}}
)

// 11. Delete One Operation
db.students.deleteOne({roll: 110})

// 12. Delete Many Operation
db.students.deleteMany({
  marks: {$lt: 60}
})

// ---------- Logical Operators ----------

// 13. AND Operation ($and)
db.students.find({
  $and: [
    {marks: {$gt: 80}},
    {age: 19}
  ]
})

// 14. OR Operation ($or)
db.students.find({
  $or: [
    {city: "Lucknow"},
    {city: "Delhi"}
  ]
})

// ---------- Sorting, Limiting, Searching, Counting ----------

// 15. Sort Operation
db.students.find().sort({marks: 1})    // A. Ascending (lowest to highest)
db.students.find().sort({marks: -1})   // B. Descending (highest to lowest)

// 16. Limit Operation
db.students.find().limit(5)

// 17. Search by City
db.students.find({city: "Lucknow"})

// 18. Count Documents (27 remain after the delete operations)
db.students.countDocuments()
